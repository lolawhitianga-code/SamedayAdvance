<Window x:Class="DiagFileMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostic File Monitor" Height="700" Width="1220"
        MinHeight="520" MinWidth="900"
        Background="{StaticResource AppBackground}">

    <Window.Resources>
        <Style TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <Expander IsExpanded="True" Background="{StaticResource BrandBlueTint}" Margin="0,4,0,0">
                            <Expander.Header>
                                <TextBlock FontWeight="Bold" Padding="4" Foreground="{StaticResource BrandNavy}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}  ({1} file(s))">
                                            <Binding Path="Name" />
                                            <Binding Path="ItemCount" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Expander.Header>
                            <Expander.Content>
                                <ItemsPresenter Margin="16,0,0,0" />
                            </Expander.Content>
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <DockPanel Margin="0,0,0,10">
                <Border DockPanel.Dock="Right" Style="{StaticResource Panel}" Width="250" Height="74"
                        Padding="12,8" VerticalAlignment="Top">
                    <Grid>
                        <Image Source="{Binding LogoImage}" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasLogo, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="SPIDA" Style="{StaticResource WordmarkPrimary}" HorizontalAlignment="Center" />
                            <TextBlock Text="M A C H I N E R Y" Style="{StaticResource WordmarkSecondary}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding Stats.ArrivedToday}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="arrived today" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding Stats.ArrivedLast7Days}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="last 7 days" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding Stats.ErrorCount}" Style="{StaticResource StatValue}" Foreground="{StaticResource DangerText}" />
                        <TextBlock Text="failed" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding Stats.DistinctMachines}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="machines seen" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding Stats.Total}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="total stored" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}" MinWidth="200">
                    <StackPanel>
                        <TextBlock Text="{Binding Stats.TopCustomerLast7Days}" Style="{StaticResource StatValue}"
                                   FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="busiest customer (7 days)" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
                </StackPanel>
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Watch folders:" VerticalAlignment="Top" Width="110" Margin="0,4,0,0" />
                <ListBox ItemsSource="{Binding WatchFolders}" SelectedItem="{Binding SelectedWatchFolder}"
                         Width="420" Height="58" Margin="0,0,6,0" />
                <StackPanel>
                    <Button Content="Add folder..." Command="{Binding AddFolderCommand}" Width="90" Margin="0,0,0,4" />
                    <Button Content="Remove" Command="{Binding RemoveFolderCommand}" Width="90"
                            IsEnabled="{Binding SelectedWatchFolder, Converter={StaticResource NotNullConverter}}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Extensions:" VerticalAlignment="Center" Width="110" />
                <TextBox Text="{Binding ExtensionsText, UpdateSourceTrigger=PropertyChanged}"
                         Width="200" Margin="0,0,6,0"
                         IsReadOnly="{Binding IsMonitoring}" />
                <TextBlock Text="(e.g. .szip, .zip)" Style="{StaticResource Hint}" Margin="0,0,12,0" />
                <TextBlock Text="Only files newer than" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                <TextBox Text="{Binding MaxAgeDays, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,6,0"
                         ToolTip="Ignore bundles whose file name timestamp is older than this. 0 processes everything." />
                <TextBlock Text="days" Style="{StaticResource FieldLabel}" Margin="0,0,16,0" />

                <Button Content="Start Monitoring" Command="{Binding StartMonitoringCommand}"
                        Width="130" Margin="0,0,6,0"
                        IsEnabled="{Binding IsMonitoring, Converter={StaticResource InverseBoolConverter}}" />
                <Button Content="Stop Monitoring" Command="{Binding StopMonitoringCommand}"
                        Width="130" Margin="0,0,12,0" IsEnabled="{Binding IsMonitoring}" />
                <CheckBox Content="Notify on arrival" IsChecked="{Binding NotifyOnArrival}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Group by:" VerticalAlignment="Center" Width="110" />
                <ComboBox ItemsSource="{Binding GroupByOptions}" SelectedItem="{Binding SelectedGroupBy}"
                          Width="180" Margin="0,0,12,0" />
                <Button Content="Refresh" Command="{Binding LoadCommand}" Width="80" Margin="0,0,12,0" />
                <Button Content="Search in logs..." Click="OpenLogSearch_Click" Width="130" Margin="0,0,20,0" />
                <TextBlock Text="Keep extracts for" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,6,0"
                         ToolTip="Days to keep unpacked files. 0 keeps everything. Baselines are never removed." />
                <TextBlock Text="days" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button Content="Clean up now" Command="{Binding CleanUpNowCommand}" Width="105" Margin="0,0,12,0" />
                <Button Content="Alerts and Zoho..." Click="OpenIntegrationSettings_Click" Width="130" Margin="0,0,12,0" />
                <Button Content="Clear database..." Command="{Binding ClearDatabaseCommand}" Width="115" />
            </StackPanel>

            <Border Style="{StaticResource Panel}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Search:" VerticalAlignment="Center" Width="56" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             Width="240" Margin="0,0,6,0"
                             ToolTip="Matches serial number, customer, file name, machine type or version. Multiple words all have to match." />

                    <TextBlock Text="Status:" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}"
                              Width="110" Margin="0,0,6,0" />

                    <TextBlock Text="Arrived from:" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <DatePicker SelectedDate="{Binding FromDate}" Width="120" Margin="0,0,6,0" />
                    <TextBlock Text="to:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding ToDate}" Width="120" Margin="0,0,12,0" />

                    <CheckBox Content="Baselines only" IsChecked="{Binding BaselinesOnly}"
                              VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Clear" Command="{Binding ClearFiltersCommand}" Width="70" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding FilterSummary}" VerticalAlignment="Center" Foreground="Gray" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="{Binding SelectionLabel}" Style="{StaticResource Hint}" Margin="0,0,8,0"
                           MaxWidth="220" TextTrimming="CharacterEllipsis" />
                <Button Content="Analyse" Command="{Binding AnalyseSelectedCommand}" Width="80" Margin="0,0,6,0"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="Read the logs in the selected bundle(s) and report what went wrong." />
                <Button Content="Compare" Command="{Binding CompareWithMasterCommand}" Width="80" Margin="0,0,12,0"
                        ToolTip="Measure the selected bundle against the benchmark master: step process, speed and settings." />
                <Button Content="Open folder" Command="{Binding OpenExtractedFolderCommand}" Width="100" Margin="0,0,6,0"
                        IsEnabled="{Binding SelectedFile.HasExtractedFolder, FallbackValue=False}" />
                <Button Content="errorlog.txt" Command="{Binding OpenErrorLogCommand}" Width="100" Margin="0,0,6,0"
                        IsEnabled="{Binding SelectedFile.HasErrorLog, FallbackValue=False}" />
                <Button Content="machinelog.txt" Command="{Binding OpenMachineLogCommand}" Width="110" Margin="0,0,6,0"
                        IsEnabled="{Binding SelectedFile.HasMachineLog, FallbackValue=False}" />
                <Button Content="changelog.txt" Command="{Binding OpenChangeLogCommand}" Width="105"
                        IsEnabled="{Binding SelectedFile.HasChangeLog, FallbackValue=False}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrandNavy}" />
        </StackPanel>

        <Border DockPanel.Dock="Right" Width="270" Margin="10,0,0,0" Padding="10"
                Style="{StaticResource Panel}">
            <StackPanel>
                <TextBlock Text="Case notes" Style="{StaticResource SectionHeading}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding SelectedFile.OriginalFileName, FallbackValue='No file selected'}"
                           TextTrimming="CharacterEllipsis" Foreground="Gray" Margin="0,0,0,2" />
                <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10">
                    <Run Text="{Binding SelectedFile.MachineName, Mode=OneWay, FallbackValue=''}" />
                    <Run Text=" | " />
                    <Run Text="{Binding SelectedFile.SoftwareName, Mode=OneWay, FallbackValue=''}" />
                    <Run Text=" " />
                    <Run Text="{Binding SelectedFile.Version, Mode=OneWay, FallbackValue=''}" />
                </TextBlock>

                <TextBlock Text="Ticket number" Margin="0,0,0,3" />
                <TextBox Text="{Binding EditTicketNumber, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding SelectedFile, Converter={StaticResource NotNullConverter}}"
                         Margin="0,0,0,10" />

                <TextBlock Text="Notes" Margin="0,0,0,3" />
                <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding SelectedFile, Converter={StaticResource NotNullConverter}}"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Height="220" Margin="0,0,0,10" />

                <Button Content="Save notes" Command="{Binding SaveNotesCommand}" Height="28" Margin="0,0,0,6"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="{Binding SelectedFile, Converter={StaticResource NotNullConverter}}" />
                <Button Content="Copy summary for ticket" Command="{Binding CopySummaryCommand}" Height="28"
                        IsEnabled="{Binding SelectedFile, Converter={StaticResource NotNullConverter}}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Style="{StaticResource Panel}"
                Background="#FFF3E8" BorderBrush="#E0A66A"
                Visibility="{Binding HasMaster, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Clear benchmark" Width="120"
                        Command="{Binding ClearMasterCommand}" />
                <TextBlock Text="{Binding MasterLabel}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,10,0" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Style="{StaticResource Panel}"
                Background="{StaticResource BrandBlueTint}" BorderBrush="{StaticResource BrandBlue}"
                Visibility="{Binding IsMachineFilterActive, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Show all machines" Width="130"
                        Command="{Binding ClearMachineFilterCommand}" />
                <TextBlock Text="{Binding MachineHistory.Headline}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,10,0" />
            </DockPanel>
        </Border>

        <DataGrid ItemsSource="{Binding FilesView}" SelectedItem="{Binding SelectedFile}"
                  SelectionMode="Extended" SelectionChanged="FilesGrid_SelectionChanged"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" AlternationCount="2">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding Details}" />
                    <!-- Gives the row's context menu a route back to the ViewModel's commands. -->
                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Open extracted _folder"
                                          Command="{Binding PlacementTarget.Tag.OpenExtractedFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding HasExtractedFolder}" />
                                <MenuItem Header="_Analyse selected file(s)"
                                          Command="{Binding PlacementTarget.Tag.AnalyseSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Set as benchmark _master"
                                          Command="{Binding PlacementTarget.Tag.SetMasterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Compare _with benchmark"
                                          Command="{Binding PlacementTarget.Tag.CompareWithMasterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Mark / unmark as known-good _baseline"
                                          Command="{Binding PlacementTarget.Tag.ToggleBaselineCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Show this machine's _history"
                                          Command="{Binding PlacementTarget.Tag.ShowMachineHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="_Copy summary for ticket"
                                          Command="{Binding PlacementTarget.Tag.CopySummaryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                                <Separator />
                                <MenuItem Header="Open _errorlog.txt"
                                          Command="{Binding PlacementTarget.Tag.OpenErrorLogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding HasErrorLog}" />
                                <MenuItem Header="Open _machinelog.txt"
                                          Command="{Binding PlacementTarget.Tag.OpenMachineLogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding HasMachineLog}" />
                                <MenuItem Header="Open _changelog.txt"
                                          Command="{Binding PlacementTarget.Tag.OpenChangeLogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding HasChangeLog}" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#FBFCFD" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsRepeatSubmission}" Value="True">
                            <Setter Property="Background" Value="{StaticResource WarningFill}" />
                        </DataTrigger>
                        <!-- Declared last so a failed bundle wins over the stripe and the repeat tint. -->
                        <DataTrigger Binding="{Binding Status}" Value="Error">
                            <Setter Property="Background" Value="{StaticResource DangerFill}" />
                            <Setter Property="Foreground" Value="{StaticResource DangerText}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <!-- Last, so the selected row stays obvious whatever else it is. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrandBlue}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding OriginalFileName}" Width="220" />
                <DataGridTextColumn Header="Serial Number" Binding="{Binding SerialNumber}" Width="130" />
                <DataGridTextColumn Header="Model" Binding="{Binding MachineType}" Width="90" />
                <DataGridTextColumn Header="Location" Binding="{Binding SiteLocation}" Width="100" />
                <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="150" />
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
                <DataGridTextColumn Header="Ticket" Binding="{Binding TicketNumber}" Width="90" />
                <DataGridTextColumn Header="Repeat" Binding="{Binding RepeatLabel}" Width="65" />
                <DataGridTextColumn Header="Baseline" Binding="{Binding BaselineLabel}" Width="70" />
                <DataGridTextColumn Header="Zoho #" Binding="{Binding ZohoTicketNumber}" Width="80" />
                <DataGridTextColumn Header="Arrived" Binding="{Binding ArrivedDisplay}" Width="130" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
