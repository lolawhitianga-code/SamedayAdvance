<Window x:Class="DiagFileMonitor.App.AnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostic analysis" Height="640" Width="900"
        MinHeight="400" MinWidth="620"
        Background="{StaticResource AppBackground}"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Copy to clipboard" Command="{Binding CopyCommand}" Width="130" Margin="0,0,6,0"
                    Style="{StaticResource PrimaryButton}" />
            <Button Content="Close" Click="Close_Click" Width="90" IsCancel="True" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}" Style="{StaticResource SectionHeading}"
                   Margin="0,0,0,8" TextWrapping="Wrap" />

        <Border Style="{StaticResource Panel}" Padding="0">
            <TextBox Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12"
                     BorderThickness="0" Background="Transparent"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" Padding="10" />
        </Border>
    </DockPanel>
</Window>
