<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DiagFileMonitor</AssemblyName>
    <RootNamespace>DiagFileMonitor.App</RootNamespace>

    <!-- Shown on the splash and in the header. Bump this when you cut a build for the floor. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiagFileMonitor.Core\DiagFileMonitor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The logo ships inside the exe so a fresh build looks right with nothing to copy.
      A logo.png beside the exe still wins over it - see BrandLogo.
    -->
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>
