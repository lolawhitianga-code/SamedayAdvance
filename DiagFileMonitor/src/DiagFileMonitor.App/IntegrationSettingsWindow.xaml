<Window x:Class="DiagFileMonitor.App.IntegrationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alerts, Zoho and email" Height="640" Width="640"
        MinHeight="480" MinWidth="560"
        Background="{StaticResource AppBackground}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="Foreground" Value="{StaticResource BrandNavy}" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource BrandNavy}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Test Zoho" Command="{Binding TestZohoCommand}" Width="100" Margin="0,0,6,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                <Button Content="Send test email" Command="{Binding TestEmailCommand}" Width="120" Margin="0,0,6,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                <Button Content="Save" Command="{Binding SaveCommand}" Width="90" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Diagnostic files">
                    <StackPanel>
                        <CheckBox Content="Timestamps in support file names are UTC"
                                  IsChecked="{Binding FileNameTimesAreUtc}" Margin="0,0,0,4" />
                        <TextBlock Text="The arrived date is read from the file name, e.g. _7_27_2026 9-53-10 PM. Untick this if the machine writes its own local time instead."
                                   TextWrapping="Wrap" Foreground="{StaticResource BrandGrey}" FontSize="11" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Only process files newer than" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                            <TextBox Text="{Binding MonitorMaxAgeDays}" Width="45" Margin="0,0,8,0" />
                            <TextBlock Text="days (0 processes everything)" Style="{StaticResource FieldLabel}" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Alerting">
                    <StackPanel>
                        <CheckBox Content="Alert when a machine sends several files in a short window"
                                  IsChecked="{Binding AlertsEnabled}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Alert after" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding BurstThreshold}" Width="45" Margin="0,0,8,0" />
                            <TextBlock Text="files from one serial within" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding BurstWindowHours}" Width="45" Margin="0,0,8,0" />
                            <TextBlock Text="hours" Style="{StaticResource FieldLabel}" />
                        </StackPanel>
                        <TextBlock Text="The alert runs the same analysis as the Analyse button and posts all of it."
                                   TextWrapping="Wrap" Foreground="{StaticResource BrandGrey}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Zoho Desk">
                    <StackPanel>
                        <CheckBox Content="Post the analysis to a Zoho ticket" IsChecked="{Binding ZohoEnabled}" Margin="0,0,0,8" />

                        <TextBlock Text="API base URL (match your data centre)" />
                        <TextBox Text="{Binding ZohoApiBaseUrl}" />

                        <TextBlock Text="Accounts base URL" />
                        <TextBox Text="{Binding ZohoAccountsBaseUrl}" />

                        <TextBlock Text="Org ID" />
                        <TextBox Text="{Binding ZohoOrgId}" />

                        <TextBlock Text="Client ID" />
                        <TextBox Text="{Binding ZohoClientId}" />

                        <TextBlock Text="Client secret" />
                        <TextBox Text="{Binding ZohoClientSecret}" />

                        <TextBlock Text="Refresh token" />
                        <TextBox Text="{Binding ZohoRefreshToken}" />

                        <TextBlock Text="Department ID (optional)" />
                        <TextBox Text="{Binding ZohoDepartmentId}" />

                        <TextBlock Text="Default contact ID (Zoho usually requires a contact on new tickets)" />
                        <TextBox Text="{Binding ZohoContactId}" />

                        <CheckBox Content="Post as a private note rather than a customer-visible reply"
                                  IsChecked="{Binding ZohoPostAsPrivateNote}" Margin="0,4,0,6" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Reuse a ticket raised for the same machine within" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ZohoReuseTicketWithinHours}" Width="45" Margin="0,0,8,0" />
                            <TextBlock Text="hours" Style="{StaticResource FieldLabel}" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Alert email (SMTP)">
                    <StackPanel>
                        <CheckBox Content="Email me when a burst is detected" IsChecked="{Binding EmailEnabled}" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Host" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SmtpHost}" Width="220" Margin="0,0,10,0" />
                            <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SmtpPort}" Width="55" Margin="0,0,10,0" />
                            <CheckBox Content="SSL" IsChecked="{Binding SmtpUseSsl}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Username" />
                        <TextBox Text="{Binding SmtpUsername}" />

                        <TextBlock Text="Password" />
                        <TextBox Text="{Binding SmtpPassword}" />

                        <TextBlock Text="From address" />
                        <TextBox Text="{Binding EmailFrom}" />

                        <TextBlock Text="Send alerts to (comma separated)" />
                        <TextBox Text="{Binding EmailTo}" />
                    </StackPanel>
                </GroupBox>

                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource DangerText}" FontSize="11"
                           Text="Credentials are stored in settings.json under your AppData folder in plain text. Anyone who can read your Windows profile can read them." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
