<Window x:Class="DiagFileMonitor.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        Height="300" Width="620" Background="{StaticResource Surface}">
    <Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource BrandStrip}" />

            <Border DockPanel.Dock="Bottom" Background="{StaticResource BrandBlueTint}" Padding="24,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Version}"
                               Style="{StaticResource VersionText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource VersionText}"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Grid Margin="40,26,40,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image Grid.Row="0" Source="{Binding LogoImage}" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasLogo, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="SPIDA" Style="{StaticResource WordmarkPrimary}" FontSize="44"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="M A C H I N E R Y" Style="{StaticResource WordmarkSecondary}"
                               FontSize="14" HorizontalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="Diagnostic File Monitor" HorizontalAlignment="Center"
                           Margin="0,18,0,0" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource BrandNavy}" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
